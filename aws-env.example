# AWS Credentials Environment Variables
# Copy this file to aws-env.sh and fill in your actual credentials
# Then run: source aws-env.sh

# Required AWS credentials
export AWS_ACCESS_KEY_ID="your-access-key-id-here"
export AWS_SECRET_ACCESS_KEY="your-secret-access-key-here"

# Optional: Only needed for temporary/session credentials (like AWS SSO)
# export AWS_SESSION_TOKEN="your-session-token-here"

# AWS Region
export AWS_REGION="us-east-1"

# Alternative: AWS Default Region
export AWS_DEFAULT_REGION="us-east-1"
