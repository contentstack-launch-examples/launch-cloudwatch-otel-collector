# AWS Configuration Example
# Copy this file to aws-env.sh and fill in your AWS credentials
# Never commit aws-env.sh to version control!

export AWS_ACCESS_KEY_ID="your_access_key_here"
export AWS_SECRET_ACCESS_KEY="your_secret_key_here"
export AWS_SESSION_TOKEN="your_session_token_here_if_using_temporary_credentials"
export AWS_REGION="us-east-1"

# Alternative: AWS Profile (if using AWS CLI profiles instead of keys)
# export AWS_PROFILE="your_profile_name"
